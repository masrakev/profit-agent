# Copy to .env and adjust. .env is never committed.

# Owner/admin connection, used only by Alembic migrations and test setup.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/profit

# Application connection. This role is not a superuser and does not bypass row-level security.
APP_DATABASE_URL=postgresql+psycopg://profit_app:profit_app@localhost:55432/profit
# Password given to the application role when the first migration creates it.
APP_DB_PASSWORD=profit_app

REDIS_URL=redis://localhost:56379/0

LOG_LEVEL=INFO

# Meta Model API (Responses API). Needed only for LLM_MODE=live or record; tests never use it.
MODEL_API_KEY=
# Spending caps in USD, enforced before every call (per run, per UTC day, optional total).
LLM_RUN_BUDGET_USD=0.50
LLM_DAILY_BUDGET_USD=5.00
# LLM_TOTAL_BUDGET_USD=25.00
LLM_SPEND_LEDGER=data/llm_spend.jsonl
# replay (default, CI): committed cassettes only. live: real calls. record: real calls written
# to backend/tests/cassettes/recorded (synthetic benchmark data only).
LLM_MODE=replay

# Decisions and execution. The approval link secret signs email approval links (HMAC-SHA256);
# the admin token guards the global kill switch endpoint.
APPROVAL_LINK_SECRET=
ADMIN_TOKEN=
# Meta Marketing API on a sandbox ad account: without these, actions run on the simulator only.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# JSON map of our campaign ids to sandbox campaign ids (demo: a synthetic store mirrored).
META_CAMPAIGN_LINKS={}

# Email (briefings, alerts, decisions). Defaults send to Mailpit (docker compose): open
# http://localhost:8025 to read them. A real provider: its SMTP relay host, port 587 with
# EMAIL_SMTP_SECURITY=starttls (or 465 with ssl), and its credentials.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURITY=none
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=Profit Agent <briefings@profit-agent.localhost>
# The web platform, for links in messages (evidence, decisions, approval confirmation).
APP_BASE_URL=http://localhost:3000
