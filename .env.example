# Copy to .env and adjust. .env is never committed.

# Owner/admin connection, used only by Alembic migrations and test setup.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/profit

# Application connection. This role is not a superuser and does not bypass row-level security.
APP_DATABASE_URL=postgresql+psycopg://profit_app:profit_app@localhost:55432/profit
# Password given to the application role when the first migration creates it.
APP_DB_PASSWORD=profit_app

REDIS_URL=redis://localhost:56379/0

LOG_LEVEL=INFO

# Meta Model API (not used before Task 3).
MODEL_API_KEY=
